<odoo>
    <!-- List view with decorations -->
    <record id="view_sale_order_tree_inherit_mo_status" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.mo.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="manufacturing_status_name"
                       decoration-warning="manufacturing_status_name == 'confirmed'"
                       decoration-info="manufacturing_status_name == 'in_progress'"
                       decoration-success="manufacturing_status_name == 'done'"
                       decoration-danger="manufacturing_status_name == 'no_mo'"/>
            </xpath>
        </field>
    </record>

    <!-- Form view footer -->
    <record id="view_sale_order_form_inherit_mo_status_footer" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mo.status.footer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <label for="manufacturing_status_name" string="Manufacturing Status:"/>
                <field name="manufacturing_status_name" nolabel="1"
                       decoration-warning="manufacturing_status_name == 'confirmed'"
                       decoration-info="manufacturing_status_name == 'in_progress'"
                       decoration-success="manufacturing_status_name == 'done'"
                       decoration-danger="manufacturing_status_name == 'no_mo'"/>
            </xpath>
        </field>
    </record>
</odoo>
